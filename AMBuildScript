import os
import shutil


def ResolveEnvPath(env, folder=None):
  if env in os.environ:
    path = os.environ[env]
    if os.path.isdir(path):
      return path
  elif folder:
    head = os.getcwd()
    oldhead = None
    while head != oldhead:
      path = os.path.join(head, folder)
      if os.path.isdir(path):
        return path
      oldhead = head
      head, _ = os.path.split(head)
  return None


def ResolveMMSRoot():
  path = builder.options.mms_path or ResolveEnvPath('MMSOURCE20', 'mmsource-2.0')
  if not path:
    path = ResolveEnvPath('MMSOURCE_DEV', 'metamod-source')
  if not path:
    path = ResolveEnvPath('MMSOURCE_DEV', 'mmsource-central')
  if not path or not os.path.isdir(path):
    raise Exception('Could not find Metamod:Source 2.0 source. Set --mms_path or MMSOURCE20.')
  return os.path.abspath(os.path.normpath(path))


mms_root = ResolveMMSRoot()


def ResolveHL2SDKManifestsRoot():
  candidates = [
    builder.options.hl2sdk_manifests,
    os.environ.get('HL2SDKMANIFESTS'),
    os.path.join(mms_root, 'hl2sdk-manifests'),
    os.path.join(builder.sourcePath, '..', 'hl2sdk-manifests'),
  ]
  for path in candidates:
    if path and os.path.isfile(os.path.join(path, 'SdkHelpers.ambuild')):
      return os.path.abspath(os.path.normpath(path))
  raise Exception('Could not find HL2SDK manifests. Set --hl2sdk-manifests or HL2SDKMANIFESTS.')


hl2sdk_manifests_root = ResolveHL2SDKManifestsRoot()
SdkHelpers = builder.Eval(os.path.join(hl2sdk_manifests_root, 'SdkHelpers.ambuild'), {
  'Project': 'metamod',
  'ManifestsPath': hl2sdk_manifests_root,
})


def additional_libs(context, binary, sdk):
  return []


def additional_defines(context, binary, sdk):
  return []


def additional_includes(context, binary, sdk):
  return [os.path.join(builder.sourcePath, 'include')]


class MMSPluginConfig(object):
  def __init__(self):
    self.sdk_manifests = []
    self.sdks = {}
    self.sdk_targets = []
    self.binaries = []
    self.mms_root = mms_root
    self.all_targets = []
    self.target_archs = set()
    self.plugin_name = builder.options.plugin_name or 'menus_export'
    self.plugin_alias = builder.options.plugin_alias or 'menus_export'

    requested_archs = builder.options.targets.split(',') if builder.options.targets else ['x86_64']
    for arch in requested_archs:
      if arch != 'x86_64':
        raise Exception('This project targets Linux x86_64; unsupported architecture: {}'.format(arch))
      cxx = builder.DetectCxx(target_arch=arch)
      if cxx.target.platform != 'linux':
        raise Exception('This project is configured for Linux targets only.')
      self.target_archs.add(cxx.target.arch)
      self.all_targets.append(cxx)

    if not self.all_targets:
      raise Exception('No suitable Linux x86_64 C/C++ compiler was found.')

  def findSdkPath(self, sdk_name):
    directory = 'hl2sdk-{}'.format(sdk_name)
    roots = [builder.options.hl2sdk_root, os.environ.get('HL2SDKROOT')]
    for root in roots:
      if root:
        path = os.path.abspath(os.path.join(root, directory))
        if os.path.isdir(path):
          return path
    return ResolveEnvPath('HL2SDK{}'.format(sdk_name.upper()), directory)

  def detectSDKs(self):
    sdk_list = [sdk for sdk in builder.options.sdks.split(',') if sdk]
    SdkHelpers.find_sdk_path = self.findSdkPath
    SdkHelpers.findSdks(builder, self.all_targets, sdk_list)
    self.sdks = SdkHelpers.sdks
    self.sdk_manifests = SdkHelpers.sdk_manifests
    self.sdk_targets = SdkHelpers.sdk_targets
    if len(self.sdks) != 1 or not self.sdk_targets:
      raise Exception('Configure exactly one SDK (use --sdks cs2).')

  def configure(self):
    for cxx in self.all_targets:
      cxx.cxxflags += ['-std=c++17', '-fno-strict-aliasing', '-Wno-invalid-offsetof', '-Wno-reorder-ctor']
      cxx.cflags += ['-pipe', '-Wall', '-Wno-unused', '-Wno-sign-compare', '-fPIC']
      cxx.defines += ['LINUX', '_LINUX', 'POSIX', '_FILE_OFFSET_BITS=64']
      if builder.options.opt == '1':
        cxx.defines += ['NDEBUG']
        cxx.cflags += ['-O3']
      elif builder.options.debug == '1':
        cxx.defines += ['DEBUG', '_DEBUG']
        cxx.cflags += ['-g3']
      cxx.cflags += ['-fno-omit-frame-pointer']
      if shutil.which('ld.lld') or shutil.which('lld'):
        cxx.linkflags += ['-fuse-ld=lld', '-Wl,--no-gnu-unique']
      if cxx.family == 'gcc':
        cxx.linkflags += ['-static-libgcc']
      elif cxx.family == 'clang':
        cxx.linkflags += ['-lgcc_eh']
      cxx.linkflags += ['-static-libstdc++']

  def Library(self, cxx, name):
    return cxx.Library(name)

  def HL2Library(self, context, compiler, name, sdk):
    binary = self.Library(compiler, name)
    cxx = binary.compiler
    mms_core_path = os.path.join(self.mms_root, 'core')
    cxx.cxxincludes += [context.currentSourcePath, mms_core_path, os.path.join(mms_core_path, 'sourcehook')]

    for manifest in self.sdk_manifests:
      cxx.defines += ['SE_{}={}'.format(manifest['define'], manifest['code'])]

    if sdk.get('source2'):
      cxx.defines += ['META_IS_SOURCE2', 'CS2']
      sdk_sources = [
        ('public', 'tier0', 'memoverride.cpp'),
        ('public', 'networkvar.cpp'),
        ('tier1', 'generichash.cpp'),
        ('entity2', 'entitysystem.cpp'),
        ('entity2', 'entityhandle.cpp'),
        ('entity2', 'concreteentitylist.cpp'),
        ('entity2', 'entityidentity.cpp'),
        ('entity2', 'entitykeyvalues.cpp'),
        ('entity2', 'entitypulse.cpp'),
        ('entity2', 'entitypulsecallcontext.cpp'),
        ('tier0_perproject', 'convar.cpp'),
        ('tier0_perproject', 'convarref.cpp'),
        ('tier0_perproject', 'concommandbase.cpp'),
        ('kv3lib', 'keyvalues3.cpp'),
      ]
      binary.sources += [os.path.join(sdk['path'], *parts) for parts in sdk_sources]
    else:
      raise Exception('The selected SDK is not Source 2; configure with --sdks cs2.')

    SdkHelpers.configureCxx(context, binary, sdk)
    cxx.linkflags += additional_libs(context, binary, sdk)
    cxx.defines += additional_defines(context, binary, sdk)
    cxx.cxxincludes += additional_includes(context, binary, sdk)
    return binary


MMSPlugin = MMSPluginConfig()
MMSPlugin.detectSDKs()
MMSPlugin.configure()

builder.Build(['AMBuilder', 'PackageScript'], {'MMSPlugin': MMSPlugin})
